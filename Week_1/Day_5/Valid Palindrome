class Solution {
public:
    bool isPalindrome(string s) {
        int n = s.size();

        int i = 0;
        int j = n-1;

        while(i<=j)
        {
            while(i<=j && !isalnum(s[i]))
            i++;

            while(i<=j && !isalnum(s[j]))
            j--;

            if(i>j)
            return 1;

            if(s[i]>='A' && s[i]<='Z')
            s[i] = s[i] + 32;

            if(s[j]>='A' && s[j]<='Z')
            s[j] = s[j] + 32;

            if(s[i] != s[j])
            return 0;

            i++;
            j--;
        }

        return 1;

    }
};
