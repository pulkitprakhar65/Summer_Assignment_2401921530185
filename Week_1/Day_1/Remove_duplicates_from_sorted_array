class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int n = nums.size();
        int start = 0;
        int end = 0;
        int k = 1;

        while(end != n)
        {
            if(nums[start] != nums[end])
            {
                nums[start+1] = nums[end];
                start++;
                k++;
            }

            end++;
        }

        return k;
    }
};
