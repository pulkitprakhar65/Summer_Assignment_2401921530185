class Solution {
public:
    int maxProfit(vector<int>& prices) {
int n=prices.size();
int maxi=INT_MIN;
int start=n-1;
for(int i=start-1;i>=0;i--)
    {
  int ans=prices[start]-prices[i];
   maxi=max(maxi,ans);
    if(prices[i]>prices[start])
    {
     start=i;
    }
    }
    if(maxi<0){
    return 0;
    }
    return maxi;
    }
};
