class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int i = 0;
        int j = 0;
        int n = nums.size();
        int c = 0;

        while(j<n)
        {
            if(nums[j] != 0)
            {
                nums[i] = nums[j];
                i++;
                j++;
            }
            else
            {
                c++;
                j++;
            }
        }

        for(int k=0 ; k<c ; k++)
        {
            nums[i] = 0;
            i++;
        }
    }
};
