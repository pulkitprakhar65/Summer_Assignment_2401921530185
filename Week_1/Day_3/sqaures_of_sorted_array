class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        int n = nums.size();
        int i = 0;
        int j = n-1;
        int k = n-1;
        vector<int>ans(n);

        while(i<=j && k>=0)
        {
            if(abs(nums[i])<=abs(nums[j]))
            {
                ans[k] = nums[j]*nums[j];
                j--;
                k--;
            }

            else
            {
                ans[k] = nums[i]*nums[i];
                i++;
                k--;
            }
        }

        return ans;
    }
};
