class Solution {
public:
    vector<vector<int>> matrixReshape(vector<vector<int>>& mat, int r, int c) {
        int row = mat.size();
        int col = mat[0].size();

        if(row*col != r*c)
        return mat;

        vector<vector<int>>ans(r,vector<int>(c));
        int a = 0;
        int b = 0;

        for(int i=0 ; i<row; i++)
        {
            for(int j=0 ; j<col ; j++)
            {
                ans[a][b] = mat[i][j];

                if(b+1<c)  // pehle col increase kro aur check kro out of bound to nhi ja rha
                b++;       // agar sahi hai to thk hai
                else
                {
                    a++;   // warna row increase krdo
                    b=0;   // row inc krne ke saath hi col ko 0 set kroge taaki element starting se fill ho
                }
            }
        }

        return ans;
    }
};
