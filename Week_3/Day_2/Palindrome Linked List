class Solution {
public:
    bool isPalindrome(ListNode* head) {
        if(head->next==NULL)
        return 1;

        // count the no of nodes
        ListNode* temp = head;
        int count=0;
        while(temp)
        {
            count++;
            temp=temp->next;
        }

        // break into half
        count=count/2;

        ListNode* prev=NULL;
        ListNode* curr=head;
        while(count--)
        {
            prev=curr;
            curr=curr->next;
        }
        prev->next=NULL;

        prev=NULL;
        ListNode* future = NULL;
        // reverse node 2nd

        while(curr)
        {
            future=curr->next;
            curr->next=prev;
            prev=curr;
            curr=future;
        }

        // head is at 1st position of list 1
        // prev is at 1st position of list 2

        // compare

        ListNode* h1 = head;
        ListNode* h2 = prev;

        while(h1)
        {
            if(h1->val != h2->val)
            return 0;

            h1=h1->next;
            h2=h2->next;
        }

        return 1;
        
    }
};
