class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        int c=0;
        ListNode* temp=head;
        while(temp)
            {
        c++;
        temp=temp->next;
            }
        c=c-n;
    if(c==0)
    {
       temp=head;
       head=head->next;
       delete temp;
       return head;
    }
        else
    {
        ListNode* prev=NULL;
        ListNode* curr=head;
        while(c--)
            {
        prev=curr;
        curr=curr->next;
            }
        prev->next=curr->next;
        delete curr;
    }
        return head;
    }
};
